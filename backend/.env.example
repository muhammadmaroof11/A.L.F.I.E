# A.L.F.I.E. Environment Variables

# --- LiveKit WebRTC & SIP ---
LIVEKIT_URL=wss://alfie-ai.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- AI Providers ---
# Speech-to-Text
DEEPGRAM_API_KEY=your_deepgram_api_key

# Language Models (Llama, GPT-4o, Claude)
OPENROUTER_API_KEY=your_openrouter_api_key

# Text-to-Speech (Voice Cloning & Synthesis)
FISH_AUDIO_API_KEY=your_fish_audio_api_key

# --- Telephony & Carrier Configuration ---
# Twilio (For PSTN Origination/Termination & DID Purchasing)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12025550100

# Telnyx (Alternative Carrier for 1-Click DID Purchasing & SIP Trunks)
TELNYX_API_KEY=your_telnyx_api_key
CARRIER_PROVIDER=twilio
LIVEKIT_SIP_DOMAIN=sip.alfie-ai.com

# Stripe (For Client Self-Serve Billing & Credit Top-Ups)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CRM & Webhooks
TWENTY_API_URL=http://twenty-server:3000
TWENTY_API_KEY=your_twenty_api_key
N8N_WEBHOOK_URL=http://n8n:5678/webhook/alfie-events

# --- System Security ---
JWT_SECRET_KEY=generate_a_secure_random_string_here
SUPER_ADMIN_EMAIL=admin@alfie.ai
SUPER_ADMIN_PASSWORD=change_this_securely
# Optional: Store pre-hashed bcrypt password directly instead of plaintext
# SUPER_ADMIN_PASSWORD_HASH=$2b$12$...

# --- Database & Redis ---
POSTGRES_PASSWORD=alfie_secure_postgres_pass
POSTGRES_DB=alfie_db
LITELLM_MASTER_KEY=generate_a_secure_litellm_master_key
TELEMETRY_DB_DSN=postgresql://postgres:alfie_secure_postgres_pass@postgres:5432/alfie_db
REDIS_DSN=redis://redis:6379/0
REDIS_PASSWORD=  # Leave blank for local dev; set strong secret in production
MONGO_USERNAME=alfie_admin
MONGO_PASSWORD=change_this_securely

# --- Operational Flags ---
SANDBOX_MODE=false  # Set to 'true' for local dev: enables mock tokens, simulated telephony, sandbox Stripe

# --- Frontend Configs ---
# Allowed Origins for CORS (Admin Portals & Marketing Sites)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- Logging & Observability ---
LOG_FORMAT=text # Set to 'json' for production cloud log aggregators (Datadog, Loki, CloudWatch)
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL


